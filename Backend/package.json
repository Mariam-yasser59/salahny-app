{
  "name": "salahny-backend",
  "version": "1.0.0",
  "description": "Salahny backend API with MongoDB and Mongoose",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "mongo:check": "node scripts/checkMongoConnection.js",
